#!/usr/bin/env bash
# KAVYA OS - System Log Monitor & Error Analyzer (klog)
# PBL Focus: Kernel dmesg ring buffer, systemd journal, error prioritization

set -e

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
RED='\033[0;31m'
NC='\033[0m'
BOLD='\033[1m'

show_help() {
    echo "Usage: klog [OPTION]"
    echo ""
    echo "Options:"
    echo "  --errors, -e    Display critical system errors & warnings"
    echo "  --kernel, -k    Display recent Linux kernel dmesg messages"
    echo "  --boot,   -b    Display log messages from current boot session"
    echo "  --follow, -f    Live stream system logs in real-time"
    echo "  --help,   -h    Show this help message"
    echo ""
}

echo -e "${BOLD}${CYAN}=== KAVYA OS: System Log & Diagnostics (klog) ===${NC}\n"

case "${1:-}" in
    --help|-h)
        show_help
        exit 0
        ;;
    --kernel|-k)
        echo -e "${YELLOW}[Recent Kernel Ring Buffer Events (dmesg)]${NC}"
        dmesg -T 2>/dev/null | tail -n 25 || echo "dmesg access requires sudo privileges."
        ;;
    --follow|-f)
        echo -e "${GREEN}[Streaming Real-Time System Journal (Ctrl+C to stop)]${NC}"
        if command -v journalctl >/dev/null 2>&1; then
            journalctl -f
        else
            tail -f /var/log/messages 2>/dev/null || tail -f /var/log/syslog 2>/dev/null
        fi
        ;;
    --boot|-b)
        echo -e "${YELLOW}[Current Boot Diagnostic Logs]${NC}"
        if command -v journalctl >/dev/null 2>&1; then
            journalctl -b --no-pager -n 25
        else
            dmesg | head -n 25
        fi
        ;;
    --errors|-e|"")
        echo -e "${YELLOW}[High Priority Errors & Failures (Alert / Critical / Error)]${NC}"
        if command -v journalctl >/dev/null 2>&1; then
            ERRORS=$(journalctl -p 0..3 -b --no-pager 2>/dev/null | tail -n 20)
            if [[ -z "$ERRORS" ]]; then
                echo -e "${GREEN}✓ No critical system or kernel errors recorded this boot.${NC}"
            else
                echo -e "${RED}${ERRORS}${NC}"
            fi
        else
            dmesg --level=err,crit,alert 2>/dev/null | tail -n 20 || echo "No critical kernel errors found."
        fi
        ;;
esac

echo ""
