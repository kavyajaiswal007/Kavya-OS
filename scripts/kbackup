#!/usr/bin/env bash
# KAVYA OS - Backup & Archive Automation Utility (kbackup)
# PBL Focus: File management, archive compression (tar/gzip), SHA256 integrity

set -e

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
WHITE='\033[1;37m'
RED='\033[0;31m'
NC='\033[0m'
BOLD='\033[1m'

show_help() {
    echo "Usage: kbackup [SOURCE_DIR] [DEST_DIR]"
    echo ""
    echo "Creates a compressed, checksummed backup archive."
    echo "Defaults:"
    echo "  SOURCE_DIR: /home/kavya (or current directory if not found)"
    echo "  DEST_DIR:   /var/backups (or ./backups if non-root)"
    echo ""
}

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    show_help
    exit 0
fi

SOURCE="${1:-/home/kavya}"
[[ ! -d "$SOURCE" ]] && SOURCE="$PWD"

if [[ -n "$2" ]]; then
    DEST="$2"
else
    if [[ -w "/var/backups" ]]; then
        DEST="/var/backups"
    else
        DEST="$PWD/kavya-backups"
    fi
fi

mkdir -p "$DEST"

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BASENAME=$(basename "$SOURCE")
ARCHIVE_NAME="backup_${BASENAME}_${TIMESTAMP}.tar.gz"
ARCHIVE_PATH="${DEST}/${ARCHIVE_NAME}"
CHECKSUM_PATH="${ARCHIVE_PATH}.sha256"

echo -e "${BOLD}${CYAN}=== KAVYA OS: Automated Backup (kbackup) ===${NC}\n"
echo -e "  • Source Target:      ${WHITE}$SOURCE${NC}"
echo -e "  • Destination File:   ${WHITE}$ARCHIVE_PATH${NC}"

echo -n "  • Compressing archive..."
tar --exclude="$DEST" -czf "$ARCHIVE_PATH" -C "$(dirname "$SOURCE")" "$(basename "$SOURCE")" 2>/dev/null
echo -e " ${GREEN}[DONE]${NC}"

echo -n "  • Generating SHA256 integrity hash..."
sha256sum "$ARCHIVE_PATH" | awk '{print $1}' > "$CHECKSUM_PATH"
HASH=$(cat "$CHECKSUM_PATH")
echo -e " ${GREEN}[DONE]${NC}"
echo -e "  • Checksum:           ${WHITE}$HASH${NC}"

ARCHIVE_SIZE=$(ls -lh "$ARCHIVE_PATH" | awk '{print $5}')
echo -e "  • Archive Size:       ${GREEN}$ARCHIVE_SIZE${NC}"
echo -e "\n${GREEN}✓ Backup successfully completed and verified.${NC}\n"
